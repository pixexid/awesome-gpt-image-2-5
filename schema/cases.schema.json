{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alosem.com/gpt-image-2-5/schema/cases.schema.json",
  "title": "GPT Image 2.5 Prompts & Examples — by Alosem",
  "type": "object",
  "required": ["schema_version", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 3 },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/campaignCase" },
          { "$ref": "#/$defs/teamCase" },
          { "$ref": "#/$defs/historicalCase" }
        ]
      }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "product_visuals",
        "posters_typography",
        "transparent_assets",
        "character_identity",
        "illustration_backgrounds",
        "focused_edits"
      ]
    },
    "imageUrls": {
      "type": "object",
      "required": ["512", "1024", "original"],
      "additionalProperties": false,
      "properties": {
        "512": { "type": "string", "format": "uri" },
        "1024": { "type": "string", "format": "uri" },
        "original": { "type": "string", "format": "uri" }
      }
    },
    "campaignCase": {
      "type": "object",
      "required": [
        "kind",
        "origin",
        "id",
        "slug",
        "title",
        "description",
        "model",
        "category",
        "mode",
        "exact_prompt",
        "tags",
        "palette",
        "dimensions",
        "aspect",
        "hasTransparency",
        "provenance",
        "review",
        "canonical_url",
        "image_urls",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "campaign-standalone" },
        "origin": { "const": "alosem" },
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "model": { "const": "GPT Image 2.5" },
        "category": { "$ref": "#/$defs/category" },
        "mode": { "type": "string", "minLength": 1 },
        "exact_prompt": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "aspect": { "type": "string", "minLength": 1 },
        "hasTransparency": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "review": { "$ref": "#/$defs/review" },
        "canonical_url": { "type": "string", "format": "uri" },
        "image_urls": { "$ref": "#/$defs/imageUrls" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "teamCase": {
      "type": "object",
      "required": [
        "kind",
        "origin",
        "id",
        "slug",
        "title",
        "description",
        "model",
        "category",
        "mode",
        "exact_prompt",
        "execution_prompt",
        "tags",
        "palette",
        "dimensions",
        "aspect",
        "hasTransparency",
        "provenance",
        "review",
        "references",
        "preview",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "campaign-team" },
        "origin": { "const": "team" },
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "model": { "const": "GPT Image 2.5" },
        "category": { "$ref": "#/$defs/category" },
        "mode": { "type": "string", "minLength": 1 },
        "exact_prompt": { "type": "string", "minLength": 1 },
        "execution_prompt": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "aspect": { "type": "string", "minLength": 1 },
        "hasTransparency": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "review": { "$ref": "#/$defs/review" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        },
        "preview": { "$ref": "#/$defs/preview" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generationTool", "exactBackend", "statement"],
      "additionalProperties": false,
      "properties": {
        "generationTool": { "const": "built-in imagegen" },
        "exactBackend": { "const": "unknown" },
        "statement": {
          "const": "Generated with built-in imagegen. Listed under the GPT Image 2.5 family; the exact backend variant was not exposed."
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["checked", "verdict", "notes"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string", "format": "date" },
        "verdict": { "enum": ["pass", "pass-with-limitations"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "required": ["file", "role", "sha256", "provenance"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provenance": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^assets/references/[a-z0-9-]+\\.(png|jpeg|jpg|webp)$"
        }
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256",
        "candidate_sha256",
        "derivation"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^assets/[a-z0-9-]+\\.jpg$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derivation": { "type": "string", "minLength": 1 },
        "format": { "const": "image/jpeg" }
      }
    },
    "historicalCase": {
      "type": "object",
      "required": ["kind", "id", "slug", "title", "model"],
      "properties": {
        "kind": { "const": "historical-composition" },
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
